{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CatFactApi": {
    "BaseUrl": "https://catfact.ninja/",
    "TimeoutSeconds": 5,
    "TotalTimeoutSeconds": 20,
    "MaxRetryAttempts": 3
  },
  "FileStorage": {
    "DirectoryName": "Responses",
    "FileName": "fact_response.txt"
  },
  "AllowedHosts": "*"
}
